# このファイルを .env にコピーして使います（.env は Git に含めない）
# 値はすべて開発用のダミーです。本番では Secret Manager などで管理します。

# 申込ID受け渡しトークンの署名鍵
APP_SECRET=dev-only-app-secret-change-me
HANDOFF_TOKEN_TTL_SECONDS=1800

# SQLite のファイルパス
DB_PATH=./data/ekyc_sample.db

# 自分自身のURL（ベンダーからのコールバック先に使う）とフロントのURL
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]

# eKYCベンダー（このサンプルでは同じサーバー内のモック）
VENDOR_BASE_URL=http://localhost:8000/mock-vendor
VENDOR_API_KEY=dev-vendor-api-key
VENDOR_WEBHOOK_SECRET=dev-vendor-webhook-secret
VENDOR_TIMEOUT_SECONDS=5
WEBHOOK_TOLERANCE_SECONDS=300

# true にするとモックベンダーがコールバックを2回送る（冪等性の確認用）
MOCK_VENDOR_DUPLICATE_CALLBACK=false

# kintone（このサンプルでは同じサーバー内のモック）
KINTONE_BASE_URL=http://localhost:8000/mock-kintone
KINTONE_APP_ID=1
KINTONE_API_TOKEN=dev-kintone-api-token

# 1以上にすると、モックkintoneが最初のN回の書き込みを503で失敗させる（リトライの確認用）
MOCK_KINTONE_FAIL_FIRST_N=0
